            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"name\":\"Lobito Trade Lda\",\"country\":\"angola\",\"contactEmail\":\"geral@lobitotrade.ao\",\"contactPhone\":\"+244 923 000 001\",\"address\":\"Rua da Industria, 42, Lobito\"}" }
          }
