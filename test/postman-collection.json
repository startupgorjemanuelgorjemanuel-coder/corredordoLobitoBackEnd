        {
          "name": "Passo 24 — Audit trail do pedido",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 200', () => pm.response.to.have.status(200));",
            "const logs = pm.response.json();",
            "pm.test('tem logs', () => pm.expect(logs.length).to.be.greaterThan(0));",
            "const actions = logs.map(l => l.action);",
            "pm.test('CREATE_ORDER', () => pm.expect(actions).to.include('CREATE_ORDER'));",
            "pm.test('PAY_ORDER', () => pm.expect(actions).to.include('PAY_ORDER'));"
          ]}}],
          "request": {
            "method": "GET", "url": "{{BASE_URL}}/logs?entity=order&entityId={{ORDER_ID}}",
            "header": [{ "key": "Authorization", "value": "Bearer {{TOKEN_STATE}}" }]
          }
        },
        {
          "name": "RBAC — POST /logs → 404 (não existe)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 404', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
            "method": "POST", "url": "{{BASE_URL}}/logs",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{TOKEN_STATE}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" }
          }
        },
        {
          "name": "RBAC — Sem token → 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('status 401', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "GET", "url": "{{BASE_URL}}/logs",
            "header": []
          }
        }
      ]
    }
  ]
}
